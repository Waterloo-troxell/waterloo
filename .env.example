# Copy to .env.local and fill in. NEVER commit a filled-in copy:
# .gitignore blocks .env* except this example file.

# ---- Browser-safe (shipped to the client, protected by row-level security) ----
# Supabase renamed these. The modern names are "publishable" (browser-safe) and
# "secret" (server only); the old "anon" and "service_role" keys still work but
# Supabase is retiring them. Use the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Local development only (printed by `npm run db:start`) ----
# The local stack's connection string, used by `npm run check:rls`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Server-only. Never put these in anything named NEXT_PUBLIC_* ----
# The secret key (formerly service_role) bypasses every row-level security
# rule. It is for migrations and backup jobs ONLY. It must never reach a
# browser and never run on a user's behalf. It lives in GitHub Actions secrets
# and Bitwarden, not here.
SUPABASE_SECRET_KEY=
